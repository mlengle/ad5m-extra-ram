#!/bin/sh
# extra-ram: frees the DSP/OP-TEE memory reservations of the AD5M through a one-shot U-Boot boot.
# Subcommands: install, check (read-only report), test (memory self-test), uninstall, boot (init hook, run by S45xram), arm-wait (arming on zmod, after zmod's emmc.sh).
#
# State files in $XR_STATE: installed (platform=, experimental=, zm_* baseline, version=), state (ok|fail|empty),
# fails (consecutive boots that did not reach the system), armed (exists = we armed the next boot),
# boot_id (the boot the hook last ran in), last (reason code of the last boot hook / arming, read by check).
#
# XR_BG=sync runs arm-wait in the foreground instead of in the background (tests); it is still a separate
# "sh extra-ram arm-wait" process, exactly as in the background.

XR_DIR=$(cd "$(dirname "$0")" && pwd)
XR_SELF=$XR_DIR/$(basename "$0")
. "$XR_DIR/lib.sh"

# --- state files ---
# xr_get NAME: first line of $XR_STATE/NAME (empty if missing)
xr_get() {
    _xr_v=""
    [ -f "$XR_STATE/$1" ] && read -r _xr_v < "$XR_STATE/$1"
    echo "$_xr_v"
}
# xr_put NAME VALUE
xr_put() {
    echo "$2" > "$XR_STATE/$1" 2>/dev/null
}
# xr_inst KEY: value of KEY= in $XR_STATE/installed
xr_inst() {
    sed -n "s/^$1=//p" "$XR_STATE/installed" 2>/dev/null | head -n 1
}
# xr_installed_write PLATFORM EXPERIMENTAL: write installed with a fresh zmod baseline
xr_installed_write() {
    xr_zmod_state
    printf 'platform=%s\nexperimental=%s\nzm_state=%s\nzm_ddr=%s\nzm_disable=%s\nzm_mark=%s\nversion=1\n' \
        "$1" "$2" "$ZM_STATE" "$ZM_DDR" "$ZM_DISABLE" "$ZM_MARK" > "$XR_STATE/installed.new" 2>/dev/null &&
        mv -f "$XR_STATE/installed.new" "$XR_STATE/installed"
}
# xr_say RU EN: print and log
xr_say() {
    xr_msg "extra-ram: $1" "extra-ram: $2"
    xr_log "$1" "$2"
}
# xr_fail CODE RU EN: disable the mode (state=fail, last=CODE) and disarm
xr_fail() {
    xr_put state fail
    xr_put last "$1"
    xr_disarm
    xr_say "ОТКАЗ: $2. Режим отключён, для включения запустите extra-ram install" \
        "FAIL: $3. Mode disabled, run extra-ram install to re-enable"
}

# --- boot hook steps ---

# Emergency: an xram_on boot without the TEE_RAM reservation, Linux may overwrite OP-TEE. Runs on every
# call of the hook, before anything else; the only action is a reboot with the stock bootcmd.
xr_safety() {
    grep -qw xram_on "$XR_CMDLINE" 2>/dev/null || return 0
    xr_verify
    [ "$XR_TEE" = missing ] || return 0
    xr_put state fail
    xr_put last tee_missing
    rm -f "$XR_STATE/armed"
    xr_say "ОТКАЗ: TEE_RAM не зарезервирован (memreserve:${XR_LIST}), перезагрузка" \
        "FAIL: TEE_RAM is not reserved (memreserve:${XR_LIST}), rebooting"
    if [ "$(xr_getenv bootcmd)" != "$STOCK_BOOTCMD" ]; then
        fw_setenv bootcmd "$STOCK_BOOTCMD"
    fi
    sync
    reboot
    exit 0
}

# Account for the result of the previous boot (once per boot). XR_NOARM=1: do not arm in this boot.
xr_postboot() {
    XR_NOARM=0
    _xr_fails=$(xr_get fails)
    case "$_xr_fails" in ''|*[!0-9]*) _xr_fails=0 ;; esac
    if grep -qw xram_on "$XR_CMDLINE" 2>/dev/null; then
        rm -f "$XR_STATE/armed"
        xr_verify
        if [ "$XR_ODD" = 1 ]; then
            xr_fail odd_reservations "неожиданные резервирования:${XR_LIST}" "unexpected reservations:${XR_LIST}"
        elif [ "$XR_TEE" = unknown ]; then
            XR_NOARM=1
            xr_put last tee_unverified
            xr_say "не удалось проверить резервирование TEE_RAM (нет $XR_FDT и $XR_MEMBLOCK), в эту загрузку не взводится" \
                "cannot verify the TEE_RAM reservation (no $XR_FDT and $XR_MEMBLOCK), not armed this boot"
        elif [ "$(xr_get state)" != fail ]; then
            # a boot never re-enables a disabled mode: only install does
            xr_put state ok
            xr_put fails 0
            xr_put last active
            xr_say "работает, MemTotal $(xr_mem_total) КБ, memreserve:${XR_LIST}" \
                "active, MemTotal $(xr_mem_total) kB, memreserve:${XR_LIST}"
        fi
    elif grep -qw xram_skip "$XR_CMDLINE" 2>/dev/null; then
        # U-Boot saw a sunxi.dtb with another CRC (firmware updated after arming): a normal boot, not a failure
        rm -f "$XR_STATE/armed"
        xr_put last dtb_changed
        xr_say "sunxi.dtb изменился после взвода, загрузка без режима" \
            "sunxi.dtb changed after arming, booted without the mode"
    elif [ -f "$XR_STATE/armed" ]; then
        # armed, but no marker: the boot did not reach the system (power cycle, the stock bootcmd ran)
        rm -f "$XR_STATE/armed"
        _xr_fails=$((_xr_fails + 1))
        xr_put fails "$_xr_fails"
        xr_put last boot_failed
        xr_say "загрузка с режимом не дошла до системы ($_xr_fails из $XR_MAX_FAILS)" \
            "the boot with the mode did not reach the system ($_xr_fails of $XR_MAX_FAILS)"
        if [ "$_xr_fails" -ge "$XR_MAX_FAILS" ]; then
            xr_fail boot_failed "$XR_MAX_FAILS неудачных загрузки подряд" "$XR_MAX_FAILS failed boots in a row"
        fi
    fi
    sync
}

# xr_edits_of_armed: set XR_EDITS to the eMMC edits carried by the current xram_boot (none when absent)
xr_edits_of_armed() {
    XR_EDITS=""
    xr_zmod_state
    _xr_bv=$(xr_getenv xram_boot)
    case "$_xr_bv" in
    *"$EMMC_FDT_DDR"*) XR_EDITS=$EMMC_FDT_DDR ;;
    *"$EMMC_FDT"*) XR_EDITS=$EMMC_FDT ;;
    esac
    return 0
}

# Arm now (no waiting): firmware check, eMMC edits on zmod, bootcmd check elsewhere, xr_arm.
# Sets last to armed or to the reason it did not arm.
#   XR_FW_CHECKED=1: the caller has just run xr_fw_check (install), do not repeat it.
#   XR_REARM_OURS=1: when bootcmd is already ours on zmod (install over an armed installation), arm again
#   with the eMMC edits of the previous arming instead of refusing as already armed.
xr_arm_now() {
    [ "$XR_FW_CHECKED" = 1 ] || xr_fw_check
    if [ "$XR_FW" != ok ]; then
        xr_put last firmware_unknown
        xr_say "прошивка не из списка проверенных, режим не взводится ($XR_FWINFO)" \
            "firmware is not in the verified list, mode not armed ($XR_FWINFO)"
        return 1
    fi
    _xr_rearm=""
    if [ "$(xr_platform)" = zmod ]; then
        if [ "$XR_REARM_OURS" = 1 ] && [ "$(xr_getenv bootcmd)" = "$xr_bootcmd" ]; then
            # re-arm with the edits of the previous arming, but only while zmod's eMMC state is still ok
            xr_edits_of_armed
            if [ -n "$XR_EDITS" ] && [ "$ZM_STATE" != ok ]; then
                xr_disarm 1
                xr_put last zmod_emmc_testing
                xr_say "не взводится: zmod_emmc_testing" "not armed: zmod_emmc_testing"
                return 1
            fi
        elif ! xr_zmod_edits >/dev/null; then
            xr_put last "$XR_REASON"
            xr_say "не взводится: $XR_REASON" "not armed: $XR_REASON"
            return 1
        fi
        # zmod armed its own one-shot boot: on failure give it back
        [ -n "$XR_EDITS" ] && _xr_rearm=1
    else
        XR_EDITS=""
        _xr_bc=$(xr_getenv bootcmd)
        if [ "$_xr_bc" != "$STOCK_BOOTCMD" ] && [ "$_xr_bc" != "$xr_bootcmd" ]; then
            xr_put last unknown_bootcmd
            xr_say "неизвестный bootcmd, режим не взводится: $_xr_bc" "unknown bootcmd, mode not armed: $_xr_bc"
            return 1
        fi
    fi
    if xr_arm "$XR_EDITS"; then
        xr_put last armed
        xr_say "взведён на следующую загрузку" "armed for the next boot"
        return 0
    fi
    xr_disarm $_xr_rearm
    xr_put last armed_failed
    xr_say "ошибка взвода (окружение U-Boot или $XR_STATE), режим не взведён" \
        "arming failed (U-Boot environment or $XR_STATE), mode not armed"
    return 1
}

# Start arm-wait: in the background (default) or in the foreground with XR_BG=sync
xr_spawn_arm_wait() {
    if [ "$XR_BG" = sync ]; then
        sh "$XR_SELF" arm-wait
    elif command -v nohup >/dev/null 2>&1; then
        nohup sh "$XR_SELF" arm-wait </dev/null >/dev/null 2>&1 &
    else
        sh "$XR_SELF" arm-wait </dev/null >/dev/null 2>&1 &
    fi
}

# The arming decision of the boot hook
xr_decide() {
    [ "$XR_NOARM" = 1 ] && return 0
    [ "$(xr_get state)" = fail ] && return 0    # last keeps the reason
    _xr_p0=$(xr_inst platform)
    _xr_p=$(xr_platform)
    if [ "$_xr_p" != "$_xr_p0" ]; then
        if [ "$_xr_p" = zmod ]; then
            # zmod installed over a stock / Forge-X installation: zmod rules from now on
            xr_installed_write zmod 0
            xr_say "установлен zmod (было: ${_xr_p0:-?}), режим теперь работает по правилам zmod" \
                "zmod installed (was: ${_xr_p0:-?}), the mode now follows the zmod rules"
        elif [ "$(xr_inst experimental)" = 1 ]; then
            sed "s/^platform=.*/platform=$_xr_p/" "$XR_STATE/installed" > "$XR_STATE/installed.new" 2>/dev/null &&
                mv -f "$XR_STATE/installed.new" "$XR_STATE/installed"
            xr_say "система сменилась: ${_xr_p0:-?} -> $_xr_p (экспериментальная установка)" \
                "platform changed: ${_xr_p0:-?} -> $_xr_p (experimental installation)"
        else
            xr_put last platform_changed
            xr_say "система сменилась: ${_xr_p0:-?} -> $_xr_p; не взводится, переустановите zmod или extra-ram с флагом --experimental" \
                "platform changed: ${_xr_p0:-?} -> $_xr_p; not armed, reinstall zmod or install extra-ram with --experimental"
            return 0
        fi
    fi
    for _xr_f in SKIP_MOD SKIP_MOD_SOFT SKIP_MOD_HARD; do
        if [ -e "$XR_TMP/$_xr_f" ]; then
            xr_put last safe_mode
            xr_say "безопасный режим Forge-X ($_xr_f), не взводится" "Forge-X safe mode ($_xr_f), not armed"
            return 0
        fi
    done
    if [ "$_xr_p" = zmod ]; then
        # zmod's emmc.sh runs later and rewrites bootcmd: arm only after it has finished
        xr_put last waiting_zmod
        xr_spawn_arm_wait
        return 0
    fi
    xr_arm_now
    return 0
}

# extra-ram boot: synchronous, fast; S45xram runs it on every boot
xr_cmd_boot() {
    [ -f "$XR_STATE/installed" ] || return 0
    xr_safety
    _xr_id=$(cat "$XR_BOOTID" 2>/dev/null)
    if [ -n "$_xr_id" ] && [ "$(xr_get boot_id)" = "$_xr_id" ]; then
        return 0
    fi
    xr_put boot_id "$_xr_id"
    xr_postboot
    xr_decide
    return 0
}

# extra-ram arm-wait: wait for zmod's emmc.sh of this boot, then arm with its eMMC edits
xr_cmd_arm_wait() {
    [ -f "$XR_STATE/installed" ] || return 0
    [ "$(xr_get state)" = fail ] && return 0
    if ! xr_zmod_wait 900; then
        xr_put last zmod_wait_timeout
        xr_say "zmod emmc.sh не закончил за 15 минут (идёт тест eMMC?), в эту загрузку не взводится" \
            "zmod emmc.sh did not finish in 15 minutes (eMMC test running?), not armed this boot"
        return 0
    fi
    # uninstall or a failure may have happened while waiting
    [ -f "$XR_STATE/installed" ] || return 0
    [ "$(xr_get state)" = fail ] && return 0
    xr_arm_now
    return 0
}

# --- install / uninstall ---

# xr_refuse RU EN: print the refusal and leave with exit 1 (always before anything is changed)
xr_refuse() {
    xr_msg "extra-ram: отказ: $1" "extra-ram: refused: $2"
    exit 1
}

# Succeeds when running as root (XR_UID overrides the uid for tests)
xr_is_root() {
    [ "${XR_UID:-$(id -u)}" = 0 ]
}

# xr_write_probe: the state directory is writable and the rootfs has room (a full rootfs would fail the
# state writes later, after U-Boot was touched)
xr_write_probe() {
    mkdir -p "$XR_STATE" 2>/dev/null || return 1
    _xi_pf=$XR_STATE/.probe
    dd if=/dev/zero of="$_xi_pf" bs=1024 count=16 2>/dev/null && [ "$(wc -c < "$_xi_pf")" -eq 16384 ] &&
        sync
    _xi_pr=$?
    rm -f "$_xi_pf"
    return $_xi_pr
}

# xr_installed_keep PLATFORM EXPERIMENTAL: rewrite installed keeping the baseline (zm_*) of the previous installation
xr_installed_keep() {
    printf 'platform=%s\nexperimental=%s\nzm_state=%s\nzm_ddr=%s\nzm_disable=%s\nzm_mark=%s\nversion=1\n' \
        "$1" "$2" "$(xr_inst zm_state)" "$(xr_inst zm_ddr)" "$(xr_inst zm_disable)" "$(xr_inst zm_mark)" \
        > "$XR_STATE/installed.new" 2>/dev/null && mv -f "$XR_STATE/installed.new" "$XR_STATE/installed"
}

# extra-ram install [--experimental] [--yes]
xr_cmd_install() {
    _xi_exp=0; _xi_yes=0
    for _xi_a in "$@"; do
        case "$_xi_a" in
        --experimental) _xi_exp=1 ;;
        --yes) _xi_yes=1 ;;
        *) xr_refuse "использование: extra-ram install [--experimental] [--yes]" \
            "usage: extra-ram install [--experimental] [--yes]" ;;
        esac
    done
    xr_is_root || xr_refuse "нужны права root (запускайте от root)" "must be run as root"

    # tools: the list of everything missing at once
    _xi_miss=""
    for _xi_t in fw_printenv fw_setenv md5sum hexdump mount; do
        command -v "$_xi_t" >/dev/null 2>&1 || _xi_miss="$_xi_miss $_xi_t"
    done
    if command -v fw_setenv >/dev/null 2>&1 && ! fw_setenv --help 2>&1 | grep -q -- --script; then
        _xi_miss="$_xi_miss fw_setenv(-s)"
    fi
    [ -f "$XR_FW_ENV_CONFIG" ] || _xi_miss="$_xi_miss $XR_FW_ENV_CONFIG"
    [ -z "$_xi_miss" ] || xr_refuse "не хватает:$_xi_miss (свои бинарники не ставим)" \
        "missing:$_xi_miss (we do not ship binaries)"

    _xi_p=$(xr_platform)
    if [ "$_xi_p" = zmod ]; then
        _xi_exp=0
        if xr_zmod_running; then
            xr_refuse "zmod ещё выполняет emmc.sh после загрузки, повторите через несколько минут" \
                "zmod is still running emmc.sh after the boot, try again in a few minutes"
        fi
    elif [ "$_xi_exp" != 1 ]; then
        xr_refuse "поддерживается только zmod (найдено: $_xi_p); для рутованной стоковой прошивки и Forge-X есть экспериментальная установка (флаг --experimental), она не проверялась на принтере" \
            "only zmod is supported (found: $_xi_p); rooted stock firmware and Forge-X have an experimental installation (flag --experimental), it has not been tested on a printer"
    fi

    if xr_printing; then
        xr_refuse "принтер печатает (Moonraker: $(xr_print_state)), повторите после печати" \
            "the printer is printing (Moonraker: $(xr_print_state)), try again when it is idle"
    fi
    _xi_mem=$(xr_mem_total)
    case "$_xi_mem" in ''|*[!0-9]*) xr_refuse "не удалось прочитать MemTotal" "cannot read MemTotal" ;; esac
    [ "$_xi_mem" -le 163840 ] || xr_refuse \
        "MemTotal $_xi_mem КБ больше 163840: платы 256 МБ не поддерживаются" \
        "MemTotal $_xi_mem kB is above 163840: 256 MB boards are not supported"
    xr_fw_check
    if [ "$XR_FW" != ok ]; then
        xr_refuse "прошивка не из списка проверенных ($XR_FWINFO). Пришлите эту строку автору, чтобы добавить прошивку" \
            "the firmware is not in the verified list ($XR_FWINFO). Please send this to the author to get the firmware added"
    fi
    _xi_bc=$(xr_getenv bootcmd)
    if [ "$_xi_bc" != "$STOCK_BOOTCMD" ] && [ "$_xi_bc" != "$xr_bootcmd" ] &&
        { [ "$_xi_p" != zmod ] || [ "$_xi_bc" != "$ARMED_BOOTCMD" ]; }; then
        xr_refuse "неизвестный bootcmd: $_xi_bc" "unknown bootcmd: $_xi_bc"
    fi
    case "$_xi_bc" in
    "$STOCK_BOOTCMD") _xi_bk=stock ;;
    "$xr_bootcmd") _xi_bk=extra-ram ;;
    *) _xi_bk=zmod-armed ;;
    esac
    xr_write_probe || xr_refuse "не удаётся записать в $XR_STATE (нет места или файловая система только для чтения)" \
        "cannot write to $XR_STATE (no space or a read-only filesystem)"

    if [ "$_xi_p" != zmod ]; then
        xr_msg "ВНИМАНИЕ: экспериментальная установка ($_xi_p), не проверялась на этой системе. При зависании выключите питание: загрузка будет обычной. Пришлите вывод extra-ram check и журнал $XR_STATE/extra-ram.log автору." \
            "WARNING: experimental installation ($_xi_p), not tested on this system. If the printer hangs, switch the power off: the next boot is a normal one. Send the output of extra-ram check and the log $XR_STATE/extra-ram.log to the author."
        if [ "$_xi_yes" != 1 ]; then
            xr_msg "Для продолжения введите yes:" "Type yes to continue:"
            read -r _xi_ans
            [ "$_xi_ans" = yes ] || xr_refuse "установка не подтверждена" "installation not confirmed"
        fi
    fi

    xr_msg "проверки пройдены: платформа $_xi_p, MemTotal $_xi_mem КБ, прошивка из списка, bootcmd: $_xi_bk" \
        "checks passed: platform $_xi_p, MemTotal $_xi_mem kB, firmware in the list, bootcmd: $_xi_bk"
    if [ "$_xi_p" = zmod ]; then
        xr_zmod_state
        xr_msg "zmod eMMC при установке: state.txt=$ZM_STATE, ddr.txt=$ZM_DDR, disable.txt=$ZM_DISABLE, метка в cmdline: $ZM_MARK" \
            "zmod eMMC at install time: state.txt=$ZM_STATE, ddr.txt=$ZM_DDR, disable.txt=$ZM_DISABLE, cmdline mark: $ZM_MARK"
    fi

    # the baseline (zmod's eMMC state at install time) is kept on re-install while the platform is the same
    if [ -f "$XR_STATE/installed" ] && [ "$(xr_inst platform)" = "$_xi_p" ] && [ -n "$(xr_inst zm_state)" ]; then
        xr_installed_keep "$_xi_p" "$_xi_exp"
    else
        xr_installed_write "$_xi_p" "$_xi_exp"
    fi || { xr_msg "extra-ram: не удалось записать $XR_STATE/installed" "extra-ram: cannot write $XR_STATE/installed"; exit 1; }
    # install is the only way to re-enable the mode after the failure limit
    [ "$(xr_get state)" = fail ] && rm -f "$XR_STATE/state"
    xr_put fails 0

    XR_FW_CHECKED=1 XR_REARM_OURS=1 xr_arm_now
    if [ $? -eq 0 ]; then
        xr_msg "Установлено. Перезагрузите принтер, затем запустите extra-ram check" \
            "Installed. Reboot the printer, then run extra-ram check"
        return 0
    fi
    _xi_last=$(xr_get last)
    if [ "$_xi_last" = armed_failed ]; then
        xr_msg "extra-ram: установлено, но взвести режим не удалось (см. $XR_STATE/extra-ram.log); повторите extra-ram install" \
            "extra-ram: installed, but arming failed (see $XR_STATE/extra-ram.log); run extra-ram install again"
        return 1
    fi
    xr_msg "Установлено, но в эту загрузку режим не взведён ($_xi_last): он взведётся в одну из следующих загрузок. Перезагрузите принтер, затем запустите extra-ram check" \
        "Installed, but not armed now ($_xi_last): it will be armed on a later boot. Reboot the printer, then run extra-ram check"
    return 0
}

# xr_stop_arm_wait: kill a running "extra-ram arm-wait" (background arming on zmod), so it cannot re-arm
# after uninstall; own shell excluded
xr_stop_arm_wait() {
    for _xu_d in "$XR_PROC"/[0-9]*; do
        _xu_n=${_xu_d##*/}
        [ "$_xu_n" = "$$" ] && continue
        [ -r "$_xu_d/cmdline" ] || continue
        _xu_c=$(tr '\0' ' ' < "$_xu_d/cmdline" 2>/dev/null)
        case "$_xu_c" in
        *"extra-ram arm-wait "*) kill "$_xu_n" 2>/dev/null ;;
        esac
    done
}

# extra-ram uninstall. The boot safety check only runs while $XR_STATE/installed exists, so bootcmd and the
# xram_* variables are restored (and verified) first; only then the files go. The variables are never removed
# while bootcmd still points at xram_main (that would hang the next boot).
xr_cmd_uninstall() {
    xr_is_root || xr_refuse "нужны права root (запускайте от root)" "must be run as root"
    xr_stop_arm_wait
    # zmod's own one-shot boot is given back only when zmod had armed under us: our xram_boot carries its eMMC
    # edits, zmod's eMMC state is ok and boot_zmod exists
    _xu_rearm=""
    if [ "$(xr_platform)" = zmod ]; then
        xr_edits_of_armed
        if [ -n "$XR_EDITS" ] && [ "$ZM_STATE" = ok ] && [ -n "$(xr_getenv boot_zmod)" ]; then _xu_rearm=1; fi
    fi
    xr_disarm $_xu_rearm
    if [ "$(xr_getenv bootcmd)" = "$xr_bootcmd" ]; then
        # restore failed: still armed, keep the failure accounting working, remove nothing
        touch "$XR_STATE/armed" 2>/dev/null
        xr_msg "extra-ram: не удалось вернуть bootcmd, ничего не удалено; повторите extra-ram uninstall" \
            "extra-ram: failed to restore bootcmd, nothing was removed; run extra-ram uninstall again"
        return 1
    fi
    xr_env_remove
    if _xu_all=$(fw_printenv 2>/dev/null) && ! echo "$_xu_all" | grep -q '^xram_'; then
        :
    else
        xr_msg "extra-ram: ошибка записи окружения U-Boot, ничего не удалено; повторите extra-ram uninstall" \
            "extra-ram: failed to write the U-Boot environment, nothing was removed; run extra-ram uninstall again"
        return 1
    fi
    rm -f "$XR_INIT"
    rm -rf "$XR_STATE" "$XR_CODE"
    sync
    xr_msg "Удалено. Перезагрузите принтер: память вернётся к обычной" \
        "Uninstalled. Reboot the printer to return to normal memory"
    return 0
}

# --- check ---

# xc_reason CODE: print the explanation of a "last" reason code (why the mode is not active / not armed)
xc_reason() {
    case "$1" in
    active) xr_msg "в этой загрузке нет метки xram_on, хотя прошлая работала: скрипт загрузки в эту загрузку не запускался" \
        "this boot has no xram_on marker although an earlier boot was active: the boot hook has not run in this boot" ;;
    armed) xr_msg "режим взведён на следующую загрузку, перезагрузите принтер" \
        "the mode is armed for the next boot, reboot the printer" ;;
    armed_failed) xr_msg "ошибка взвода (окружение U-Boot или $XR_STATE, см. $XR_STATE/extra-ram.log), запустите extra-ram install ещё раз" \
        "arming failed (U-Boot environment or $XR_STATE, see $XR_STATE/extra-ram.log), run extra-ram install again" ;;
    waiting_zmod) xr_msg "идёт ожидание: режим взводится после того, как zmod закончит emmc.sh этой загрузки (повторите check через несколько минут)" \
        "waiting: the mode is armed after zmod has finished emmc.sh of this boot (run check again in a few minutes)" ;;
    safe_mode) xr_msg "безопасный режим Forge-X, режим не взводится" "Forge-X safe mode, the mode is not armed" ;;
    unknown_bootcmd) xr_msg "bootcmd не штатный и не наш (его изменил кто-то другой), режим не взводится" \
        "bootcmd is neither the stock one nor ours (someone else changed it), the mode is not armed" ;;
    already_armed) xr_msg "bootcmd уже наш, повторно не взводится" "bootcmd is already ours, not armed again" ;;
    odd_reservations) xr_msg "в загрузке с режимом неожиданные резервирования памяти, режим отключён" \
        "unexpected memory reservations in a boot with the mode, the mode was disabled" ;;
    boot_failed) xr_msg "загрузка с режимом не дошла до системы ($(xc_fails) из $XR_MAX_FAILS)" \
        "the boot with the mode did not reach the system ($(xc_fails) of $XR_MAX_FAILS)" ;;
    dtb_changed) xr_msg "sunxi.dtb изменился после взвода (обновилась прошивка?), U-Boot загрузил систему без режима" \
        "sunxi.dtb changed after arming (firmware updated?), U-Boot booted without the mode" ;;
    firmware_unknown)
        xr_fw_check
        xr_msg "прошивка не из списка проверенных ($XR_FWINFO). Пришлите эту строку автору, чтобы добавить прошивку" \
            "the firmware is not in the verified list ($XR_FWINFO). Please send this to the author to get the firmware added" ;;
    zmod_emmc_testing) xr_msg "zmod сейчас проверяет 50 МГц (state.txt не ok): режим не взводится, чтобы не смешивать сбои; взведётся после проверки" \
        "zmod is testing eMMC 50 MHz now (state.txt is not ok): not armed so the failures do not mix; it is armed after the test" ;;
    zmod_unknown_boot_zmod) xr_msg "boot_zmod в zmod не из известных строк (новая версия zmod?), режим не взводится; пришлите вывод check автору" \
        "zmod's boot_zmod is not one of the known strings (new zmod version?), not armed; send the output of check to the author" ;;
    zmod_wait_timeout) xr_msg "zmod emmc.sh не закончил за 15 минут (идёт тест eMMC?), в ту загрузку режим не взведён" \
        "zmod emmc.sh did not finish in 15 minutes (eMMC test running?), not armed in that boot" ;;
    platform_changed) xr_msg "система сменилась (при установке: $(xr_inst platform), сейчас: $(xr_platform)), режим не взводится; переустановите zmod или extra-ram с флагом --experimental" \
        "the platform changed (at install: $(xr_inst platform), now: $(xr_platform)), not armed; reinstall zmod or install extra-ram with --experimental" ;;
    tee_missing) xr_msg "в загрузке с режимом TEE_RAM не был зарезервирован (опасно), режим отключён" \
        "TEE_RAM was not reserved in a boot with the mode (dangerous), the mode was disabled" ;;
    tee_unverified) xr_msg "резервирование TEE_RAM проверить не удалось (нет $XR_FDT и $XR_MEMBLOCK), в ту загрузку режим не взводится" \
        "the TEE_RAM reservation could not be verified (no $XR_FDT and $XR_MEMBLOCK), not armed in that boot" ;;
    "") xr_msg "результата пока нет, перезагрузите принтер" "no result recorded yet, reboot the printer" ;;
    *) xr_msg "неизвестная причина: $1" "unknown reason: $1" ;;
    esac
}

# xc_fails: the failed-boot counter as a number
xc_fails() {
    _xc_f=$(xr_get fails)
    case "$_xc_f" in ''|*[!0-9]*) _xc_f=0 ;; esac
    echo "$_xc_f"
}

# xc_extra_ram: print the "Extra RAM" line; sets XC_LAST_SHOWN=1 when the explanation of "last" went into it
xc_extra_ram() {
    XC_LAST_SHOWN=0
    _xc_last=$(xr_get last)
    _xc_state=$(xr_get state)
    _xc_why=""
    if grep -qw xram_on "$XR_CMDLINE" 2>/dev/null; then
        xr_verify
        if [ "$XR_TEE" = missing ]; then _xc_why=tee_missing
        elif [ "$XR_ODD" = 1 ]; then _xc_why=odd_reservations
        elif [ "$XR_TEE" = unknown ]; then _xc_why=tee_unverified
        else
            xr_msg "Дополнительная память: работает (MemTotal $(xr_mem_total) КБ, TEE_RAM зарезервирован)" \
                "Extra RAM: active (MemTotal $(xr_mem_total) kB, TEE_RAM reserved)"
            return 0
        fi
    elif grep -qw xram_skip "$XR_CMDLINE" 2>/dev/null; then
        _xc_why=dtb_changed
    else
        _xc_why=$_xc_last
    fi
    XC_LAST_SHOWN=1
    if [ "$_xc_state" = fail ]; then
        xr_msg "Дополнительная память: не работает: режим отключён ($(xc_reason "$_xc_why"))" \
            "Extra RAM: not active: the mode is disabled ($(xc_reason "$_xc_why"))"
    else
        xr_msg "Дополнительная память: не работает: $(xc_reason "$_xc_why")" \
            "Extra RAM: not active: $(xc_reason "$_xc_why")"
    fi
}

# xc_zmod: the zmod eMMC lines (only on zmod): comparison with the baseline of install, advice
xc_zmod() {
    [ "$(xr_platform)" = zmod ] || return 0
    xr_zmod_state
    _xc_bs=$(xr_inst zm_state); _xc_bd=$(xr_inst zm_ddr); _xc_bx=$(xr_inst zm_disable)
    _xc_hang=0
    if [ "$ZM_STATE" = "$_xc_bs" ] && [ "$ZM_DDR" = "$_xc_bd" ] && [ "$ZM_DISABLE" = "$_xc_bx" ]; then
        xr_msg "eMMC 50 МГц/DDR52: как при установке (state=$ZM_STATE, ddr.txt=$ZM_DDR, disable.txt=$ZM_DISABLE, метка в cmdline: $ZM_MARK)" \
            "eMMC 50 MHz/DDR52: same as at install (state=$ZM_STATE, ddr.txt=$ZM_DDR, disable.txt=$ZM_DISABLE, cmdline mark: $ZM_MARK)"
    else
        _xc_dis=""
        if [ "$ZM_DISABLE" != "$_xc_bx" ]; then
            _xc_dis=$(xr_msg " (disable.txt: было $_xc_bx, сейчас $ZM_DISABLE)" " (disable.txt: was $_xc_bx, now $ZM_DISABLE)")
        fi
        xr_msg "eMMC 50 МГц/DDR52: изменилось: было state=$_xc_bs ddr=$_xc_bd, сейчас state=$ZM_STATE ddr=$ZM_DDR$_xc_dis" \
            "eMMC 50 MHz/DDR52: changed: was state=$_xc_bs ddr=$_xc_bd, now state=$ZM_STATE ddr=$ZM_DDR$_xc_dis"
        if [ "$ZM_STATE" = fail ] && [ "$_xc_bs" != fail ]; then
            _xc_hang=1
            xr_msg "  Что делать (50 МГц): удалите файлы в /opt/config/mod_data/emmc (disable.txt оставьте, если создавали его вы) и перезагрузите принтер дважды" \
                "  What to do (50 MHz): delete the files in /opt/config/mod_data/emmc (keep disable.txt if you created it) and reboot twice"
            if [ "$_xc_bd" = 1 ]; then
                xr_msg "  Когда state.txt снова станет ok, для DDR52 создайте /opt/config/mod_data/emmc/ddr.txt и перезагрузите принтер" \
                    "  When state.txt is ok again, for DDR52 create /opt/config/mod_data/emmc/ddr.txt and reboot"
            fi
        elif [ "$_xc_bd" = 1 ] && [ "$ZM_DDR" = 0 ] && [ "$ZM_STATE" = ok ]; then
            _xc_hang=1
            xr_msg "  Что делать (DDR52): создайте /opt/config/mod_data/emmc/ddr.txt и перезагрузите принтер" \
                "  What to do (DDR52): create /opt/config/mod_data/emmc/ddr.txt and reboot"
        fi
    fi
    [ "$(xc_fails)" -gt 0 ] && _xc_hang=1
    if [ "$_xc_hang" = 1 ]; then
        xr_msg "  Примечание: если загрузка с дополнительной памятью зависает, zmod сразу отключает DDR52 (удаляет ddr.txt), а 50 МГц после 3 неудач" \
            "  Note: if the boot with extra RAM hangs, zmod drops DDR52 at once (deletes ddr.txt) and 50 MHz after 3 failures"
    fi
}

# extra-ram check: read-only report, exit 0 always
xr_cmd_check() {
    if [ ! -f "$XR_STATE/installed" ]; then
        xr_msg "Дополнительная память: не установлено. Запустите extra-ram install" \
            "Extra RAM: not installed. Run extra-ram install"
        return 0
    fi
    xc_extra_ram
    xc_zmod
    if [ "$(xr_getenv bootcmd)" = "$xr_bootcmd" ]; then
        xr_msg "Взведён на следующую загрузку: да" "Armed for the next boot: yes"
    elif [ "$XC_LAST_SHOWN" = 0 ] && [ -n "$_xc_last" ] && [ "$_xc_last" != active ]; then
        # the line above is "active": say why the next boot is not armed
        xr_msg "Взведён на следующую загрузку: нет ($(xc_reason "$_xc_last"))" \
            "Armed for the next boot: no ($(xc_reason "$_xc_last"))"
    else
        xr_msg "Взведён на следующую загрузку: нет" "Armed for the next boot: no"
    fi
    if [ "$(xr_inst experimental)" = 1 ]; then
        xr_msg "Экспериментальная установка ($(xr_inst platform)): на этой системе не проверялась; при зависании выключите питание, загрузка будет обычной" \
            "Experimental installation ($(xr_inst platform)): not tested on this system; if the printer hangs, switch the power off, the next boot is a normal one"
    fi
    if [ "$_xc_state" = fail ]; then
        xr_msg "Режим отключён после неудач: запустите extra-ram install ещё раз, чтобы включить его" \
            "The mode is disabled after failures: run extra-ram install again to re-enable it"
    fi
    return 0
}

# extra-ram test [--force]: the memory self-test (about 11 minutes, runs in the foreground).
# Refuses unless installed, the mode is active in this boot (xram_on in the cmdline), the printer is idle and
# python3 exists; Moonraker unreachable is a refusal too unless --force (an unreachable Moonraker may hide a print).
# Exit 0 when the last line of the self-test output is "RESULT PASS", else 1.
xr_cmd_test() {
    _xt_force=0
    for _xt_a in "$@"; do
        case "$_xt_a" in
        --force) _xt_force=1 ;;
        *) xr_refuse "использование: extra-ram test [--force]" "usage: extra-ram test [--force]" ;;
        esac
    done
    xr_is_root || xr_refuse "нужны права root (запускайте от root)" "must be run as root"
    [ -f "$XR_STATE/installed" ] || xr_refuse "extra-ram не установлен (extra-ram install)" \
        "extra-ram is not installed (extra-ram install)"
    grep -qw xram_on "$XR_CMDLINE" 2>/dev/null || xr_refuse \
        "в этой загрузке нет метки xram_on: тест имеет смысл только при работающем режиме (см. extra-ram check)" \
        "no xram_on marker in this boot: the test makes sense only while the mode is active (see extra-ram check)"
    [ -x "$XR_PYTHON" ] || xr_refuse "нет $XR_PYTHON (python3 нужен тесту памяти)" \
        "$XR_PYTHON not found (the memory test needs python3)"
    [ -f "$XR_SELFTEST" ] || xr_refuse "нет скрипта теста: $XR_SELFTEST" "the self-test script is missing: $XR_SELFTEST"
    _xt_st=$(xr_print_state)
    if xr_printing; then
        xr_refuse "принтер печатает (Moonraker: $_xt_st), повторите после печати" \
            "the printer is printing (Moonraker: $_xt_st), try again when it is idle"
    fi
    if [ -z "$_xt_st" ] && [ "$_xt_force" != 1 ]; then
        xr_refuse "Moonraker недоступен, не удалось проверить, что принтер не печатает; если уверены, что он простаивает, добавьте --force" \
            "Moonraker is unreachable, cannot check that the printer is not printing; add --force if you are sure it is idle"
    fi
    xr_msg "Тест памяти займёт около 11 минут, принтер всё это время должен простаивать (не запускайте печать). Если принтер зависнет, выключите и включите питание и пришлите вывод extra-ram check автору. Результат: последняя строка RESULT PASS или RESULT FAIL, журналы: $XR_TESTDIR" \
        "The memory test takes about 11 minutes, keep the printer idle meanwhile (do not start a print). If the printer freezes, power-cycle it and send the output of extra-ram check to the author. Result: the last line is RESULT PASS or RESULT FAIL, logs: $XR_TESTDIR"
    export XR_STATE XR_TESTDIR XR_PYTHON XR_CMDLINE XR_MEMINFO XR_BOOTID XR_MEMBLOCK
    _xt_out=$XR_TMP/extra-ram-test.$$
    sh "$XR_SELFTEST" 2>&1 | tee "$_xt_out"
    _xt_last=$(tail -n 1 "$_xt_out" 2>/dev/null | tr -d '\r')
    rm -f "$_xt_out"
    [ "$_xt_last" = "RESULT PASS" ]
}

case "$1" in
install) shift; xr_cmd_install "$@"; exit $? ;;
uninstall) xr_cmd_uninstall; exit $? ;;
check) xr_cmd_check; exit 0 ;;
test) shift; xr_cmd_test "$@"; exit $? ;;
boot) xr_cmd_boot ;;
arm-wait) xr_cmd_arm_wait ;;
*)
    xr_msg "использование: extra-ram install|check|test|uninstall|boot|arm-wait" "usage: extra-ram install|check|test|uninstall|boot|arm-wait"
    exit 1
    ;;
esac
exit 0
